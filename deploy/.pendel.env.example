# Mein Pendel environment (charter G4).
#
# Copy this file to deploy/.pendel.env, next to compose.yaml -- that is
# where `env_file: .pendel.env` resolves -- and edit the values below.
# deploy/.pendel.env is gitignored (.*.env) and must never be committed, and
# it must never be placed inside /opt/dockerdata/pendel, which is the data
# volume mounted into both containers.
#
# Uncommented lines below are shipped as-is; every commented-out line is
# optional and must be uncommented and given a real value to take effect.
# Never uncomment a line and leave its value empty -- most of these vars are
# read with plain int()/os.environ[...] and an empty string is not treated
# as unset.

# Data directory inside the container (matches the /data volume mount).
# Do not change unless the compose volume target also changes.
PENDEL_DATA_DIR=/data

# HAFAS REST API base URL. Uncomment only to point at a different instance
# than the public https://v6.bvg.transport.rest.
# PENDEL_HAFAS_BASE_URL=https://v6.bvg.transport.rest

# Minutes before a saved commute's departure window that it becomes due for
# a check. Must be a positive integer. Uncomment to override the built-in
# default (30).
# PENDEL_CHECK_LEAD_MIN=30

# Per-IP rate limit in requests per minute (used once the rate limiter
# lands). Must be a positive integer. Uncomment to override the built-in
# default (60).
# PENDEL_RATE_LIMIT_PER_MIN=60

# Public origin of the web app, without a trailing slash. Notifications end
# with a link to the "today" page; without this they carry only the bare
# path /today, which Telegram and ntfy do not show as a link.
# PENDEL_PUBLIC_URL=https://pendel.example.org

# Telegram bot token for the Telegram notification channel. Leave commented
# out to disable Telegram notifications entirely (they become a no-op).
# PENDEL_TELEGRAM_BOT_TOKEN=changeme-telegram-bot-token

# Telegram bot username, used to build the /start deep link shown on the
# notification settings page. Leave commented out if Telegram is disabled.
# PENDEL_TELEGRAM_BOT_USERNAME=changeme_bot

# ntfy server base URL for the ntfy notification channel. Leave commented
# out to disable ntfy notifications entirely (they become a no-op).
# PENDEL_NTFY_URL=https://ntfy.example.org

# The web service runs behind Caddy on caddy_network, so uvicorn's peer
# address for every request is Caddy's container IP, not the visitor's --
# uvicorn only trusts X-Forwarded-For from 127.0.0.1/::1 by default. Set
# this to the caddy_network subnet (see DEPLOY.md) so uvicorn accepts
# X-Forwarded-For from Caddy alone and the per-IP rate limiter (G5) sees
# real visitor IPs again. uvicorn reads this env var directly (no CLI flag
# needed). Never set this to '*': any other container on caddy_network
# could then spoof X-Forwarded-For and pick its own rate-limit bucket, or
# make every visitor share one.
# FORWARDED_ALLOW_IPS=changeme-caddy_network-subnet
